---
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";

import { getGroupedPosts }
from "../lib/blog";

import { getCollection } from "astro:content";

const groupedPosts =
  await getGroupedPosts();

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const featuredPosts = allPosts.filter((post) => post.data.featured);
---

<MainLayout title="Jibran Dev">
    <Header groupedPosts={groupedPosts}/>
    <div class="flex min-h-screen">
        <Sidebar groupedPosts={groupedPosts}/>

        <main class="flex-1">
            <section
              class="px-10 py-10 lg:px-20"
            >
              <p
                class="text-sm tracking-wider uppercase font-bold"
              >
                  Welcome
              </p>

              <div class="mt-6 max-w-5xl">
                <h1
                  class="max-w-4xl text-5xl leading-[1.05] tracking-tight lg:text-6xl"
                >
                    Hi, I'm Jibran
                </h1>

                <p
                  class="mt-6 text-lg leading-8 text-[var(--muted)]"
                >
                  A blog where I write about the ideas, algorithms, systems, and code behind software.
                </p>

                <div class="mt-10">
                    <a
                      href="/blog/the-blog/introduction"
                      class="inline-block border-l-4 border-[var(--border)] pl-5 py-1 text-sm uppercase tracking-widest text-[var(--muted)] transition-colors hover:border-black hover:text-black"
                    >
                        Introduction
                    </a>
                </div>
              </div>
            </section>

            {featuredPosts.length > 0 && (
                <section class="border-t border-[var(--border)] px-10 py-14 lg:px-20">
                    <div class="mb-8 flex items-center justify-between">
                        <h2 class="text-3xl">Featured</h2>
                    </div>

                    <div class="grid gap-6 xl:grid-cols-3">
                        {
                            featuredPosts.map((post) => (
                                <a href={`/blog/${post.id.replace(/\.mdx?$/, "")}`} class="block outline-none">
                                    <article class="group cursor-pointer border border-[var(--border)] p-8 transition hover:-translate-y-1 h-full flex flex-col">
                                        <p class="text-xs uppercase tracking-[0.25em] text-[var(--muted)]">
                                            {post.id.split("/")[0].split("-").map((word) => word.charAt(0).toUpperCase() + word.slice(1)).join(" ")}
                                        </p>

                                        <h3 class="mt-5 text-3xl leading-tight transition group-hover:underline">
                                            {post.data.title}
                                        </h3>

                                        <p class="mt-5 leading-7 text-[var(--muted)] flex-1">
                                            {post.data.description}
                                        </p>

                                        <div class="mt-5 border-t border-[var(--border)] pt-4 text-sm text-[var(--muted)]">
                                            {post.data.pubDate} &middot; {post.data.readingTime}
                                        </div>
                                    </article>
                                </a>
                            ))
                        }
                    </div>
                </section>
            )}
        </main>
    </div>
</MainLayout>
