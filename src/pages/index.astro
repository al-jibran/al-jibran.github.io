---
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";

import { getGroupedPosts }
from "../lib/blog";

import { getCollection } from "astro:content";

const groupedPosts =
  await getGroupedPosts();

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const featuredPosts = allPosts.filter((post) => post.data.featured);
const recentPosts = [...allPosts]
  .sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf())
  .slice(0, 3);

function formatDate(dateValue: string | Date) {
  const date = new Date(dateValue);
  const day = date.getDate().toString().padStart(2, "0");
  const month = date.toLocaleString("en-US", { month: "short" });
  const year = date.getFullYear();
  return `${day} ${month}, ${year}`;
}
---

<MainLayout>
    <Header groupedPosts={groupedPosts}/>
    <div class="flex min-h-screen">
        <Sidebar groupedPosts={groupedPosts}/>

        <main class="flex-1 flex flex-col xl:flex-row min-w-0">
            <!-- First Column -->
            <div class="flex-1 flex flex-col min-w-0">
                <!-- Section 1: Welcome -->
                <section class="border-b border-[var(--border)] p-8 lg:p-12">
                    <h1 class="text-7xl leading-none tracking-[-0.06em] sm:text-8xl lg:text-[9rem]">
                        AL JIBRAN
                    </h1>
                    <p class="mt-6 text-base leading-8 text-[var(--muted)] lg:text-lg">
                        All things software engineering - things I've learned and things I am learning
                    </p>
                </section>


                <!-- Section 2: Featured Rows -->
                {featuredPosts.length > 0 && (
                    <section class="flex flex-col">
                        <div class="border-b border-[var(--border)] p-6 lg:p-8">
                            <h2 class="text-xs uppercase tracking-[0.25em] text-[var(--muted)]">
                                Featured
                            </h2>
                        </div>
                        {featuredPosts.slice(0, 3).map((post) => (
                            <a
                                href={`/blog/${post.id.replace(/\.mdx?$/, "")}`}
                                class="group grid border-b border-[var(--border)] outline-none transition-colors hover:bg-[var(--text)] hover:text-[var(--bg)] md:grid-cols-[140px_1fr]"
                            >
                                <div class="flex items-center justify-center border-b border-[var(--border)] bg-[var(--surface)] px-4 py-3 text-center transition-colors group-hover:bg-transparent group-hover:border-[var(--bg)]/30 md:border-b-0 md:border-r">
                                    <p class="text-[10px] uppercase tracking-[0.25em] text-[var(--bg)] group-hover:text-[var(--bg)]/70">
                                        {post.id.split("/")[0].split("-").map((word) => word.charAt(0).toUpperCase() + word.slice(1)).join(" ")}
                                    </p>
                                </div>
                                <div class="grid gap-6 p-6 lg:grid-cols-[1fr_auto] lg:items-end lg:p-8">
                                    <div>
                                        <h3 class="text-2xl leading-tight lg:text-4xl">
                                            {post.data.title}
                                        </h3>
                                        <p class="mt-4 max-w-2xl text-sm leading-relaxed text-[var(--muted)] group-hover:text-[var(--bg)]/70 lg:text-base">
                                            {post.data.description}
                                        </p>
                                    </div>
                                    <div class="border-t border-[var(--border)] pt-4 text-[10px] uppercase tracking-widest text-[var(--muted)] group-hover:border-[var(--bg)]/30 group-hover:text-[var(--bg)]/70 lg:border-l lg:border-t-0 lg:pl-8 lg:pt-0">
                                        {formatDate(post.data.pubDate)}
                                    </div>
                                </div>
                            </a>
                        ))}
                    </section>
                )}

                {/**
                Old featured tile grid preserved for later, when there is more content.

                {featuredPosts.length > 0 && (
                    <section class="grid grid-cols-1 min-[405px]:grid-cols-2 2xl:grid-cols-3 xl:flex-1">
                        {featuredPosts.slice(0, 3).map((post, i) => (
                            <a href={`/blog/${post.id.replace(/\.mdx?$/, "")}`} class={`group aspect-square flex flex-col outline-none border-[var(--border)] border-b ${i === 0 ? 'min-[405px]:border-r' : ''} ${i === 1 ? '2xl:border-r' : ''} ${i === 2 ? 'min-[405px]:border-r 2xl:border-r-0' : ''} hover:bg-[var(--text)] hover:text-[var(--bg)] transition-colors overflow-hidden`}>
                                <div class="border-b border-[var(--border)] bg-[var(--surface)] px-6 lg:px-8 py-3 lg:py-4 transition-colors group-hover:bg-transparent group-hover:border-[var(--bg)]/30">
                                    <p class="text-[10px] lg:text-xs uppercase tracking-[0.25em] text-[var(--bg)] group-hover:text-[var(--bg)]/70">
                                        {post.id.split("/")[0].split("-").map((word) => word.charAt(0).toUpperCase() + word.slice(1)).join(" ")}
                                    </p>
                                </div>
                                <div class="flex-1 flex flex-col p-6 lg:p-8 min-h-0">
                                    <h3 class="text-xl lg:text-3xl leading-tight">
                                        {post.data.title}
                                    </h3>
                                    <p class="mt-4 lg:mt-6 text-sm lg:text-base leading-relaxed text-[var(--muted)] group-hover:text-[var(--bg)]/70 flex-1 line-clamp-3 lg:line-clamp-4">
                                        {post.data.description}
                                    </p>
                                    <div class="mt-4 lg:mt-6 pt-4 lg:pt-6 border-t border-[var(--border)] group-hover:border-[var(--bg)]/30 text-[10px] lg:text-xs text-[var(--muted)] group-hover:text-[var(--bg)]/70 uppercase tracking-widest shrink-0">
                                        {formatDate(post.data.pubDate)}
                                    </div>
                                </div>
                            </a>
                        ))}
                    </section>
                )}
                */}
            </div>

            <!-- Second Column: Recent Writings -->
            <aside class="hidden xl:flex w-[320px] shrink-0 border-l border-[var(--border)] flex-col bg-[var(--bg)]">
                <div class="p-8 border-b border-[var(--border)] flex items-center h-auto">
                    <h2 class="text-xs uppercase tracking-[0.2em] font-bold text-[var(--muted)]">Recent Writing</h2>
                </div>
                <ul class="flex flex-col">
                    {recentPosts.map((post, i) => (
                        <li>
                            <a href={`/blog/${post.id.replace(/\.mdx?$/, "")}`} class={`group block p-8 outline-none border-[var(--border)] transition-colors hover:bg-[var(--text)] hover:text-[var(--bg)] ${i !== recentPosts.length - 1 ? 'border-b' : ''}`}>
                                <h4 class="text-xl leading-snug">
                                    {post.data.title}
                                </h4>
                                <p class="mt-4 text-xs uppercase tracking-widest text-[var(--muted)] group-hover:text-[var(--bg)]/70">
                                    {formatDate(post.data.pubDate)}
                                </p>
                            </a>
                        </li>
                    ))}
                </ul>
            </aside>
        </main>
    </div>
</MainLayout>
