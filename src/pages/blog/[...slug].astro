---
import {
  getCollection,
  render,
} from "astro:content";

import { getGroupedPosts }
from "../../lib/blog";

import MainLayout from "../../layouts/MainLayout.astro";
import Header from "../../components/Header.astro";
import Sidebar from "../../components/Sidebar.astro";


export async function getStaticPaths() {
  const posts =
    await getCollection("blog");

  return posts.map((post) => ({
    params: {
      slug:
        post.id.replace(
          /\.mdx?$/,
          ""
        ),
    },
    props: { post },
  }));
}

const groupedPosts =
  await getGroupedPosts();

const { post } = Astro.props;

const { Content, headings } =
  await render(post);
---

<MainLayout title={post.data.title}>
    <Header groupedPosts={groupedPosts}/>

  <div class="flex min-h-screen">
      <Sidebar groupedPosts={groupedPosts}/>

    <main
        class="flex flex-1 px-5 py-8 sm:px-8 lg:px-16"
    >
        <div
            class="flex min-w-0 w-full flex-col gap-12 xl:flex-row xl:gap-16"
        >
          <article
            class="editorial-prose min-w-0 flex-1 max-w-5xl"
          >

        <div
          class="mb-10 border-b border-[var(--border)] pb-8"
        >
          <p
            class="text-xs uppercase tracking-[0.2em] text-[var(--muted)]"
          >
              {
                post.id
                  .split("/")[0]
                  .split("-")
                  .map(
                    word =>
                      word.charAt(0).toUpperCase() +
                      word.slice(1)
                  )
                  .join(" ")
              }
          </p>

          <h1 class="mt-4">
            {post.data.title}
          </h1>

          <p
            class="mt-3 text-lg text-[var(--muted)]"
          >
            {post.data.description}
          </p>

          <div
            class="mt-6 text-sm text-[var(--muted)]"
          >
            {post.data.readingTime}
          </div>
        </div>

        {
          headings.length > 0 && (
            <details
              class="mb-10 border-y border-[var(--border)] py-4 xl:hidden"
            >
              <summary
                class="cursor-pointer text-sm uppercase tracking-[0.2em]"
              >
                On this page
              </summary>
        
              <ul class="mt-4 space-y-3">
                {headings
                  .filter(
                    heading =>
                      heading.depth === 2
                  )
                  .map((heading) => (
                    <li>
                      <a
                        href={`#${heading.slug}`}
                        class="text-sm text-[var(--muted)]"
                      >
                        {heading.text}
                      </a>
                    </li>
                  ))}
              </ul>
            </details>
          )
        }
        <Content />
      </article>
      <aside
        class="sticky top-[110px] hidden h-fit w-[220px] shrink-0 xl:block"
      >
        <p
          class="hidden xl:block sticky top-[110px] h-fit w-[220px] shrink-0"
        >
          On this page
        </p>

        <nav>
          <ul class="space-y-3">
            {headings
              .filter(
                heading =>
                  heading.depth === 2
              )
              .map((heading) => (
                <li>
                  <a
                    href={`#${heading.slug}`}
                    class="block text-sm leading-6 text-[var(--muted)] transition hover:text-black hover:italic"
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
          </ul>
        </nav>
      </aside>
      </div>
    </main>
  </div>
</MainLayout>