<footer class="border-t border-[var(--border)]">
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4">
        <section class="border-b border-[var(--border)] p-5 md:border-r xl:border-b-0">
            <h2 class="mb-3 text-[10px] uppercase tracking-[0.25em] text-[var(--muted)]">
                Source
            </h2>
            <p class="text-sm leading-7 text-[var(--muted)]">
                The source for this blog is public. If you spot a problem,
                please open a&nbsp;
                <a
                    href="https://github.com/al-jibran/jibran/issues"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-[var(--text)] underline decoration-[var(--border)] underline-offset-4 hover:italic"
                    >GitHub issue</a
                >.
            </p>
        </section>

        <section class="border-b border-[var(--border)] p-5 xl:border-b-0 xl:border-r">
            <h2 class="mb-3 text-[10px] uppercase tracking-[0.25em] text-[var(--muted)]">
                Writing
            </h2>
            <p class="text-sm leading-7 text-[var(--muted)]">
                Unless noted otherwise, original work on this blog is available
                under CC BY 4.0 with attribution.
            </p>
        </section>

        <section class="border-b border-[var(--border)] p-5 md:border-r md:border-b-0">
            <h2 class="mb-3 text-[10px] uppercase tracking-[0.25em] text-[var(--muted)]">
                Code
            </h2>
            <p class="text-sm leading-7 text-[var(--muted)]">
                Original source code and code snippets may be reused with
                attribution under CC BY 4.0, unless noted otherwise.
            </p>
        </section>

        <section class="p-5">
            <h2 class="mb-3 text-[10px] uppercase tracking-[0.25em] text-[var(--muted)]">
                References
            </h2>
            <p class="text-sm leading-7 text-[var(--muted)]">
                Third-party assets, references, and quoted work remain under
                their original terms.
            </p>
        </section>
    </div>
</footer>
