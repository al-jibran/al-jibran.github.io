---
import SocialLinks from './SocialLinks.astro';

import { SITE_HEADER_TITLE } from '../consts.ts';
import { type GroupedPosts } from '../lib/blog.ts';

interface Props {
  groupedPosts: GroupedPosts
}

const { groupedPosts } = Astro.props;

const formatCategory = (category: string) =>
    category
        .split("-")
        .map((word) => word[0].toUpperCase() + word.slice(1))
        .join(" ");
---

<header
    class="sticky top-0 z-30 border-b border-[var(--border)] bg-[var(--bg)]/90 backdrop-blur-sm"
>
    <div class="flex">
        <!-- Desktop left -->
        <div
            class="hidden xl:flex w-[280px] shrink-0 items-center justify-center border-r border-[var(--border)] px-8 py-5"
        >
            <h1 class="text-3xl cursor-default"><a href="/">{SITE_HEADER_TITLE}</a></h1>
        </div>

        <!-- Main header -->
        <div
            class="flex flex-1 items-baseline justify-between px-6 py-5 lg:px-20"
        >
            <!-- Mobile -->
            <div class="flex items-baseline gap-4 xl:hidden">
                <button id="menu-open" class="text-xl cursor-pointer">☰</button>
                <span class="text-sm uppercase tracking-[0.2em]">
                    <a href="/">{SITE_HEADER_TITLE}</a>
                </span>
            </div>


            <div class="relative ml-auto">
                <button
                    id="theme-toggle"
                    class="inline-block border-b border-[var(--border)] pb-1 text-sm uppercase tracking-widest text-[var(--muted)] transition-colors hover:border-[var(--text)] hover:text-[var(--text)] cursor-pointer"
                >
                    Theme
                </button>
                <div
                    id="theme-menu"
                    class="absolute right-0 top-full mt-4 hidden flex-col border border-[var(--border)] bg-[var(--bg)] min-w-[120px] shadow-sm"
                >
                    <button data-theme-btn="light" class="px-4 py-3 text-left text-xs uppercase tracking-widest text-[var(--muted)] transition-colors hover:bg-[var(--border)] hover:text-[var(--text)] cursor-pointer">Light</button>
                    <button data-theme-btn="sepia" class="px-4 py-3 text-left text-xs uppercase tracking-widest text-[var(--muted)] transition-colors hover:bg-[var(--border)] hover:text-[var(--text)] border-t border-[var(--border)] cursor-pointer">Sepia</button>
                    <button data-theme-btn="dark" class="px-4 py-3 text-left text-xs uppercase tracking-widest text-[var(--muted)] transition-colors hover:bg-[var(--border)] hover:text-[var(--text)] border-t border-[var(--border)] cursor-pointer">Dark</button>
                    <button data-theme-btn="amoled" class="px-4 py-3 text-left text-xs uppercase tracking-widest text-[var(--muted)] transition-colors hover:bg-[var(--border)] hover:text-[var(--text)] border-t border-[var(--border)] cursor-pointer">Amoled</button>
                </div>
            </div>
        </div>
    </div>
</header>

<!-- Mobile overlay -->
<div id="menu-overlay" class="fixed inset-0 z-40 hidden bg-black/30"></div>

<!-- Mobile drawer -->
<aside
    id="mobile-menu"
    class="fixed top-0 left-0 z-50 flex flex-col h-screen w-[300px] -translate-x-full overflow-y-auto border-r border-[var(--border)] bg-[var(--bg)] p-8 transition-transform duration-300"
>
        <div class="flex items-center justify-end">
            <button id="menu-close" class="cursor-pointer"> ✕ </button>
        </div>

        <nav class="mt-10 space-y-10">
            {
                Object.entries(groupedPosts).map(([category, posts]) => (
                    <details open class="group">
                        <summary class="flex cursor-pointer items-center justify-between mb-4 border-b border-[var(--border)] pb-2 text-[11px] uppercase tracking-[0.25em] text-[var(--muted)]">
                            {formatCategory(category)}
                            <span class="text-xs text-[var(--muted)] group-open:hidden">
                                [+]
                            </span>
                            <span class="text-xs text-[var(--muted)] group-open:inline-block hidden">
                                [-]
                            </span>
                        </summary>

                        <ul class="space-y-3">
                            {posts.map((post) => (
                                <li>
                                    <a
                                        href={`/blog/${post.id.replace(
                                            /\.mdx?$/,
                                            "",
                                        )}`}
                                        class="block w-full transition-colors border-b border-transparent pb-1 hover:border-[var(--border)]"
                                    >
                                        {post.data.title}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </details>
                ))
            }
        </nav>

        <div class="mt-auto pt-10">
            <SocialLinks class="border-t border-[var(--border)] pt-6" />
        </div>
    </aside>

<script>
    const menu = document.getElementById("mobile-menu");

    const overlay = document.getElementById("menu-overlay");

    function openMenu() {
        menu?.classList.remove("-translate-x-full");

        overlay?.classList.remove("hidden");
    }

    function closeMenu() {
        menu?.classList.add("-translate-x-full");

        overlay?.classList.add("hidden");
    }

    document.getElementById("menu-open")?.addEventListener("click", openMenu);

    document.getElementById("menu-close")?.addEventListener("click", closeMenu);

    overlay?.addEventListener("click", closeMenu);

    // Theme dropdown
    const themeToggle = document.getElementById("theme-toggle");
    const themeMenu = document.getElementById("theme-menu");

    themeToggle?.addEventListener("click", (e) => {
        e.stopPropagation();
        themeMenu?.classList.toggle("hidden");
        themeMenu?.classList.toggle("flex");
    });

    document.addEventListener("click", (e) => {
        if (!themeMenu?.contains(e.target as Node) && e.target !== themeToggle) {
            themeMenu?.classList.add("hidden");
            themeMenu?.classList.remove("flex");
        }
    });

    // Theme switching logic
    const themeButtons = document.querySelectorAll("[data-theme-btn]");

    themeButtons.forEach(btn => {
        btn.addEventListener("click", () => {
            const theme = btn.getAttribute("data-theme-btn");
            if (theme) {
                document.documentElement.setAttribute("data-theme", theme);
                localStorage.setItem("theme", theme);
            }
            themeMenu?.classList.add("hidden");
            themeMenu?.classList.remove("flex");
        });
    });
</script>
