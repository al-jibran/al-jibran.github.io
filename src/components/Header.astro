---
import githubIcon from '../assets/github.svg?raw';
import linkedinIcon from '../assets/linkedin.svg?raw';
import cvIcon from '../assets/cv.svg?raw';

const { groupedPosts } = Astro.props;

const formatCategory = (category) =>
    category
        .split("-")
        .map((word) => word[0].toUpperCase() + word.slice(1))
        .join(" ");
---

<header
    class="sticky top-0 z-30 border-b border-[var(--border)] bg-[var(--bg)]/90 backdrop-blur-sm"
>
    <div class="flex">
        <!-- Desktop left -->
        <div
            class="hidden xl:flex w-[280px] shrink-0 items-center border-r border-[var(--border)] px-8 py-5"
        >
            <h1 class="text-3xl cursor-default"><a href="/">JIBRAN DEV</a></h1>
        </div>

        <!-- Main header -->
        <div
            class="flex flex-1 items-center justify-between px-6 py-5 lg:px-20"
        >
            <!-- Mobile -->
            <div class="flex items-center gap-4 xl:hidden">
                <button id="menu-open" class="text-lg cursor-pointer">
                    ☰
                </button>

                <span class="text-sm uppercase tracking-[0.2em]">
                    <a href="/"> JIBRAN DEV </a>
                </span>
            </div>

            <!-- Desktop -->
            <div
                class="hidden xl:block text-xs uppercase tracking-[0.35em] text-[var(--muted)]"
            >
                Software Engineering Journal
            </div>

            <button
                class="h-8 w-8 rounded-full border border-[var(--border)] cursor-pointer transition hover:bg-black hover:text-white"
            >
                ☼
            </button>
        </div>
    </div>
</header>

<!-- Mobile overlay -->
<div id="menu-overlay" class="fixed inset-0 z-40 hidden bg-black/30"></div>

<!-- Mobile drawer -->
<aside
    id="mobile-menu"
    class="fixed top-0 left-0 z-50 flex flex-col h-screen w-[300px] -translate-x-full overflow-y-auto border-r border-[var(--border)] bg-[var(--bg)] p-8 transition-transform duration-300"
>
        <div class="flex items-center justify-end">
            <button id="menu-close" class="cursor-pointer"> ✕ </button>
        </div>

        <nav class="mt-10 space-y-10">
            {
                Object.entries(groupedPosts).map(([category, posts]) => (
                    <details open class="group">
                        <summary class="flex cursor-pointer items-center justify-between mb-4 border-b border-[var(--border)] pb-2 text-[11px] uppercase tracking-[0.25em] text-[var(--muted)]">
                            {formatCategory(category)}
                            <span class="text-xs text-[var(--muted)] group-open:hidden">
                                [+]
                            </span>
                            <span class="text-xs text-[var(--muted)] group-open:inline-block hidden">
                                [-]
                            </span>
                        </summary>

                        <ul class="space-y-3">
                            {posts.map((post) => (
                                <li>
                                    <a
                                        href={`/blog/${post.id.replace(
                                            /\.mdx?$/,
                                            "",
                                        )}`}
                                        class="hover:italic"
                                    >
                                        {post.data.title}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </details>
                ))
            }
        </nav>

        <div class="mt-auto pt-10">
            <div
                class="border-t border-[var(--border)] pt-6 flex justify-around"
            >
                <a href="#" aria-label="Github" class="text-xl text-[var(--muted)] hover:text-black transition-colors" set:html={githubIcon} />
                <a href="#" aria-label="LinkedIn" class="text-xl text-[var(--muted)] hover:text-black transition-colors" set:html={linkedinIcon} />
                <a href="#" aria-label="CV" class="text-xl text-[var(--muted)] hover:text-black transition-colors" set:html={cvIcon} />
            </div>
        </div>
    </aside>

<script>
    const menu = document.getElementById("mobile-menu");

    const overlay = document.getElementById("menu-overlay");

    function openMenu() {
        menu?.classList.remove("-translate-x-full");

        overlay?.classList.remove("hidden");
    }

    function closeMenu() {
        menu?.classList.add("-translate-x-full");

        overlay?.classList.add("hidden");
    }

    document.getElementById("menu-open")?.addEventListener("click", openMenu);

    document.getElementById("menu-close")?.addEventListener("click", closeMenu);

    overlay?.addEventListener("click", closeMenu);
</script>
