---
import SocialLinks from './SocialLinks.astro';

import { type GroupedPosts } from '../lib/blog.ts';

interface Props {
  groupedPosts: GroupedPosts
}

const formatCategory = (
  category: string
) =>
  category
    .split("-")
    .map(
      (word) =>
        word.charAt(0).toUpperCase() +
        word.slice(1)
    )
    .join(" ");

const { groupedPosts = {} } =
  Astro.props;
---

<aside
  class="scrollbar-none hidden xl:flex flex-col sticky top-[75px] h-[calc(100vh-75px)] w-[280px] shrink-0 overflow-y-auto overscroll-contain border-r border-[var(--border)] px-8 py-8"
>
    <nav class="space-y-10 grow">
      {
        Object.entries(groupedPosts).map(
          ([category, posts]) => (
            <details open class="group">
                <summary
                  class="flex cursor-pointer items-center justify-between mb-4 border-b border-[var(--border)] pb-2 text-[11px] uppercase tracking-[0.25em] text-[var(--muted)]"
                >
                  {formatCategory(category)}
                  <span class="text-xs text-[var(--muted)] group-open:hidden">
                    [+]
                  </span>
                  <span class="text-xs text-[var(--muted)] group-open:inline-block hidden">
                    [-]
                  </span>
                </summary>
                <ul class="space-y-3">
                  {posts.map((post) => (
                    <li>
                      <a
                        href={`/blog/${post.id.replace(/\.mdx?$/, "")}`}
                        class="block w-full transition-colors border-b border-transparent pb-1 hover:border-[var(--border)]"
                      >
                        {post.data.title}
                      </a>
                    </li>
                  ))}
                </ul>
            </details>
          )
        )
      }
    </nav>

    <SocialLinks class="border-t border-[var(--border)] pt-4" />
</aside>