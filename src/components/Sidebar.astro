---
import { getCollection } from "astro:content";

const posts = await getCollection(
  "blog",
  ({ data }) => !data.draft
);

const formatCategory = (
  category: string
) =>
  category
    .split("-")
    .map(
      (word) =>
        word.charAt(0).toUpperCase() +
        word.slice(1)
    )
    .join(" ");

const groupedPosts = posts.reduce(
  (acc, post) => {
    const category =
      post.id.split("/")[0];

    if (!acc[category]) {
      acc[category] = [];
    }

    acc[category].push(post);

    return acc;
  },
  {} as Record<string, typeof posts>
);
---

<aside
  class="hidden xl:block sticky top-[73px] h-[calc(100vh-73px)] w-[280px] shrink-0 overflow-y-auto border-r border-[var(--border)] px-8 py-8"
>
    <nav class="space-y-10">
      {
        Object.entries(groupedPosts).map(
          ([category, posts]) => (
            <section>
              <h2
                class="mb-4 border-b border-[var(--border)] pb-2 text-[11px] uppercase tracking-[0.25em] text-[var(--muted)]"
              >
                {formatCategory(category)}
              </h2>
    
              <ul class="space-y-3">
                {posts.map((post) => (
                  <li>
                    <a
                      href={`/blog/${post.id.replace(/\.mdx?$/, "")}`}
                      class="transition hover:italic"
                    >
                      {post.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        )
      }
    </nav>

  <div class="mt-auto pt-10">
    <div
      class="border-t border-[var(--border)] pt-6"
    >
      <p
        class="text-xs uppercase tracking-[0.2em] text-[var(--muted)]"
      >
        Writing Since
      </p>

      <p class="mt-1 text-sm">
        2026
      </p>
    </div>
  </div>
</aside>