---
const sections = {
  "Software Design": [
    "SOLID Principles",
    "Composition vs Inheritance",
  ],
  "System Design": [
    "Designing Chat Systems",
    "Rate Limiting",
  ],
  "Software Engineering": [
    "Node.js Architecture",
    "API Design",
  ],
  "Problem Solving": [
    "Binary Trees",
    "Recursion",
  ],
};
---

<aside
  class="hidden xl:flex w-[280px] shrink-0 flex-col border-r border-[var(--border)] px-8"
>

  <nav class="mt-8 space-y-10">
    {
      Object.entries(sections).map(
        ([category, posts]) => (
          <section>
            <h2
              class="mb-4 border-b border-[var(--border)] pb-2 text-[11px] uppercase tracking-[0.25em] text-[var(--muted)]"
            >
              {category}
            </h2>

            <ul class="space-y-3">
              {posts.map((post) => (
                <li>
                  <a
                    href="#"
                    class="text-[15px] transition hover:underline"
                  >
                    {post}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      )
    }
  </nav>

  <div class="mt-auto pt-10">
    <div
      class="border-t border-[var(--border)] pt-6"
    >
      <p
        class="text-xs uppercase tracking-[0.2em] text-[var(--muted)]"
      >
        Writing Since
      </p>

      <p class="mt-1 text-sm">
        2026
      </p>
    </div>
  </div>
</aside>