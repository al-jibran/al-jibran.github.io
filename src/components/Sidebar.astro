---
import githubIcon from '../assets/github.svg?raw';
import linkedinIcon from '../assets/linkedin.svg?raw';
import rssIcon from '../assets/rss.svg?raw';

import { type GroupedPosts } from '../lib/blog.ts';

interface Props {
  groupedPosts: GroupedPosts
}

const formatCategory = (
  category: string
) =>
  category
    .split("-")
    .map(
      (word) =>
        word.charAt(0).toUpperCase() +
        word.slice(1)
    )
    .join(" ");

const { groupedPosts = {} } =
  Astro.props;
---

<aside
  class="hidden xl:flex flex-col sticky top-[75px] h-[calc(100vh-75px)] w-[280px] shrink-0 overflow-y-auto border-r border-[var(--border)] px-8 py-8"
>
    <nav class="space-y-10 grow">
      {
        Object.entries(groupedPosts).map(
          ([category, posts]) => (
            <details open class="group">
                <summary
                  class="flex cursor-pointer items-center justify-between mb-4 border-b border-[var(--border)] pb-2 text-[11px] uppercase tracking-[0.25em] text-[var(--muted)]"
                >
                  {formatCategory(category)}
                  <span class="text-xs text-[var(--muted)] group-open:hidden">
                    [+]
                  </span>
                  <span class="text-xs text-[var(--muted)] group-open:inline-block hidden">
                    [-]
                  </span>
                </summary>
                <ul class="space-y-3">
                  {posts.map((post) => (
                    <li>
                      <a
                        href={`/blog/${post.id.replace(/\.mdx?$/, "")}`}
                        class="block w-full transition-colors border-b border-transparent pb-1 hover:border-[var(--border)]"
                      >
                        {post.data.title}
                      </a>
                    </li>
                  ))}
                </ul>
            </details>
          )
        )
      }
    </nav>

    <div
      class="border-t border-[var(--border)] pt-6 flex justify-around"
    >
      <a href="https://www.github.com/al-jibran" target="_blank" rel="noopener noreferrer" aria-label="Github" class="text-xl text-[var(--muted)] hover:text-[var(--text)] transition-colors" title="Github" set:html={githubIcon} />
      <a href="https://www.linkedin.com/in/al-jibran" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="text-xl text-[var(--muted)] hover:text-[var(--text)] transition-colors" title="LinkedIn" set:html={linkedinIcon} />
      <a href="/rss.xml" target="_blank" rel="noopener noreferrer" aria-label="RSS feed" class="text-xl text-[var(--muted)] hover:text-[var(--text)] transition-colors" title="RSS" set:html={rssIcon} />
    </div>
</aside>