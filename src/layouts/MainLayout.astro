---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "Jibran Dev" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <script is:inline>
      const theme = localStorage.getItem("theme") || "dark";
      document.documentElement.setAttribute("data-theme", theme);
    </script>

    <title>{title}</title>
  </head>

  <body class="min-h-screen">
    <div
      class="mx-auto min-h-screen max-w-full border-x border-[var(--border)] bg-[var(--bg)] shadow-sm"
    >
      <slot />
    </div>
  </body>
</html>